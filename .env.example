# ==== Khu Phố Của Tôi — biến môi trường (KHÔNG commit file .env thật) ====

# --- Domain (Q5): chọn MỘT trong hai phương án, chỉ đổi biến env ---
# Phương án A — domain riêng:  BASE_PATH=""                   SITE_ORIGIN=https://khupho.fpt.vn
# Phương án B — chạy dưới path: BASE_PATH="/khu-pho-biet-thuong" SITE_ORIGIN=https://fpt.vn
#   ⇒ ĐÃ CHỐT 8/9: production là phương án B, site ở https://fpt.vn/khu-pho-biet-thuong
#   (SITE_ORIGIN chỉ là ORIGIN, KHÔNG kèm path — code tự ghép basePath vào, xem lib/url.ts)
#
# ⚠️ BASE_PATH là BUILD ARG, không phải biến runtime: đổi giá trị BẮT BUỘC build lại image
#    (`docker compose ... build web`). Đặt sẵn ở đây thì cả build tay lẫn CI đều lấy đúng.
BASE_PATH=
SITE_ORIGIN=http://localhost
# Địa chỉ Caddy lắng nghe: ':80' cho local, 'khupho.fpt.vn' để tự động TLS
SITE_ADDRESS=:80

# --- Database ---
POSTGRES_USER=khupho
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=khupho
# Khi chạy ngoài Docker (dev): DATABASE_URL=postgres://khupho:khupho_dev@localhost:5432/khupho
DATABASE_URL=postgres://khupho:doi-mat-khau-nay@db:5432/khupho

# --- Bảo mật định danh (07 §2.1) — 2 khoá TÁCH BIỆT, sinh ngẫu nhiên ≥256-bit ---
# PEPPER: openssl rand -hex 32   (KHÔNG xoay được giữa chừng — chọn kỹ ngay từ đầu)
PHONE_PEPPER=
# Khoá AES-256-GCM (base64 32 byte): openssl rand -base64 32
PHONE_AES_KEY=

# --- Ảnh upload (filesystem) ---
# Thư mục gốc chứa ảnh, key `public/...`/`private/...` nằm ngay dưới. Mặc định /app/uploads
# (đường dẫn trong image). Trong compose biến này bị ghi đè thành /app/uploads + volume;
# production Kubernetes mount PVC NFS vào /app/uploads.
# Dev ngoài Docker: bỏ comment dòng dưới (thư mục ./uploads đã có trong .gitignore)
# UPLOAD_DIR=./uploads

# --- Seed (tuỳ chọn) ---
# SEED_ADMIN_PASSWORD=KhuPho@2026!Demo
