# Security header của Khu Phố Của Tôi — NGUỒN DUY NHẤT, dùng chung cho cả 2 mode:
#   - mode 4 service: deploy/Caddyfile import file này (docker-compose.yml mount vào)
#   - mode production (VM ai-law dùng chung): CI copy file này vào
#     /etc/caddy/conf.d/khupho-headers.caddy rồi reload caddy (.github/workflows/deploy.yml)
#
# CỐ Ý là snippet chứ không phải Caddyfile đầy đủ: /etc/caddy/Caddyfile trên VM còn
# site block của law.ailab.city và fb.ailab.city (CSP KHÁC — có fonts.googleapis.com,
# CDN Facebook). Repo này chỉ được sở hữu header của chính nó, tuyệt đối không ghi đè
# cả file, không thì deploy của khupho sẽ đánh sập 2 app kia.
#
# Hai directive dễ gãy, đừng bỏ:
#   - frame-src youtube-nocookie: thiếu → iframe TVC rơi về default-src 'self',
#     Chrome chặn, hiện ô xám "This content is blocked" (cả trang chủ lẫn /admin/noi-dung).
#   - Referrer-Policy no-referrer là quy tắc của 07 §63 nên GIỮ NGUYÊN; riêng iframe TVC
#     tự ghi đè bằng thuộc tính referrerPolicy trên thẻ (xem components/home/CampaignMedia.tsx),
#     nếu không YouTube trả "Error 153 — Video player configuration error".
(khupho_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
		-Server
	}
}
