# Reverse proxy — service DUY NHẤT mở port (07 §2.2). TLS tự động khi SITE_ADDRESS là domain.
{$SITE_ADDRESS} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# frame-src BẮT BUỘC có youtube-nocookie: không khai báo thì iframe TVC rơi về
		# default-src 'self' → Chrome chặn, hiện ô xám "This content is blocked"
		# (cả trang chủ lẫn ô xem trước ở /admin/noi-dung).
		# frame-ancestors 'none' = bản CSP của X-Frame-Options DENY (giữ cả hai cho trình duyệt cũ).
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
		-Server
	}

	reverse_proxy web:3000
}
